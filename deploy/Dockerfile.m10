FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY src/ src/
COPY apps/m10-private-node.mjs apps/m10-private-node.mjs
RUN mkdir -p /coord /state && chown node:node /coord /state && chmod 0700 /state
USER node
CMD ["node", "apps/m10-private-node.mjs"]
